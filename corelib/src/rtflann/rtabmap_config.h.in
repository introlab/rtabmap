#ifndef RTFLANN_RTABMAP_CONFIG_H_
#define RTFLANN_RTABMAP_CONFIG_H_

// Not named config.h: rtflann has one of its own, and the source directory
// comes first in the include path, so it would shadow this one silently.

// Generated by CMake from config.h.in. Carrying the option in a header rather
// than in a compile definition keeps a toggle from rebuilding everything: a
// definition given to the compiler lands in the target's flags, which every
// object file of the library depends on, while this header is only included by
// the sources that use rtflann.
#cmakedefine FLANN_KDTREE_MEM_OPT

#endif /* RTFLANN_RTABMAP_CONFIG_H_ */
